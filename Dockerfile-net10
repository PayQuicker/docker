FROM docker:29-dind

# Install minimal tooling and runtime deps, then use Microsoft's dotnet-install
# script to install side-by-side SDK channels (7,8,9,10) into
# `/usr/share/dotnet`. This avoids fragile filesystem COPYs between images.

RUN apk add --no-cache --update \
    bash \
    curl \
    ca-certificates \
    tar \
    gzip \
    icu-libs \
    libgcc \
    libstdc++ \
    openssl \
    icu-libs \
    krb5-libs \
    libgcc \
    libintl \
    libssl3 \
    libstdc++ \
    zlib \
    jq \
    git \
    npm \
    yarn \
    python3 \
    py3-pip \
    curl \
    gnupg \
    libc6-compat

# Download and run the official installer for the SDK channels you need.
RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --version 7.0.400 --install-dir /usr/share/dotnet --architecture x64 \
    && /tmp/dotnet-install.sh --version 8.0.100 --install-dir /usr/share/dotnet --architecture x64 \
    && /tmp/dotnet-install.sh --version 8.0.201 --install-dir /usr/share/dotnet --architecture x64 \
    && /tmp/dotnet-install.sh --version 8.0.303 --install-dir /usr/share/dotnet --architecture x64 \
    && /tmp/dotnet-install.sh --version 8.0.403 --install-dir /usr/share/dotnet --architecture x64 \
    && /tmp/dotnet-install.sh --channel 9.0 --install-dir /usr/share/dotnet --architecture x64 \
    && /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/share/dotnet --architecture x64 \
    && rm -f /tmp/dotnet-install.sh

# Ensure CLI sees the installed SDKs
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="$DOTNET_ROOT:$PATH"

# Install build dependencies, create venv, install azure-cli into it, then remove build deps
RUN apk add --no-cache --virtual .build-deps \
      build-base \
      python3-dev \
      libffi-dev \
      openssl-dev \
      linux-headers \
      pkgconfig \
      cargo \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install --no-cache-dir azure-cli \
    && /opt/venv/bin/az aks install-cli \
    && apk del .build-deps \
    && rm -rf /root/.cache/pip/* \
    && curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -x -s -- -b /usr/local/bin

# Update PATH to include the virtual environment
ENV PATH="/opt/venv/bin:$PATH"

RUN wget https://get.helm.sh/helm-v3.19.0-linux-amd64.tar.gz -O - | tar -xz
RUN mv linux-amd64/helm /usr/bin/helm
ENTRYPOINT ["dockerd-entrypoint.sh"]
CMD []